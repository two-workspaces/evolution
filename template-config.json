{
  "services": {
    "852b8448-eb60-4868-96d5-6e7bbb95a6e3": {
      "icon": "https://raw.githubusercontent.com/EvolutionAPI/evolution-api/main/public/images/evolution-logo.png",
      "name": "Evolution API",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/two-workspaces/evolution:PENDING"
      },
      "variables": {
        "AUTHENTICATION_API_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Your API key. Send it in the apikey header and use it to sign in at /manager.",
          "isOptional": false
        },
        "SERVER_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of this service. Wired automatically.",
          "isOptional": false
        },
        "PORT": {
          "defaultValue": "8080",
          "description": "Port the API listens on and Railway routes to.",
          "isOptional": false
        },
        "DATABASE_CONNECTION_URI": {
          "defaultValue": "postgresql://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}?schema=evolution_api",
          "description": "Postgres over the private network. Wired automatically.",
          "isOptional": false
        },
        "CACHE_REDIS_URI": {
          "defaultValue": "redis://:${{Redis.REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379/6?family=0",
          "description": "Redis over the private network. It holds WhatsApp's encryption keys. Keep family=0: Railway's private network is IPv6.",
          "isOptional": false
        },
        "MESSAGE_RETENTION_DAYS": {
          "defaultValue": "",
          "description": "Optional. Delete saved messages older than this many days. Empty keeps them for good.",
          "isOptional": true
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {
        "852b8448-eb60-4868-96d5-6e7bbb95a6e3": {
          "mountPath": "/evolution/instances"
        }
      }
    },
    "895afd8a-58fe-4d25-94f7-440547be23bc": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "name": "Postgres",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18"
      },
      "variables": {
        "POSTGRES_DB": {
          "defaultValue": "evolution",
          "description": "Database name",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "evolution",
          "description": "Database user",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated database password",
          "isOptional": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Data subdirectory - keeps Postgres happy on Railway volumes",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Time for Postgres to shut down cleanly on redeploy",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "895afd8a-58fe-4d25-94f7-440547be23bc": {
          "mountPath": "/var/lib/postgresql/data"
        }
      }
    },
    "a9d419dd-c4ed-47cc-9405-ad89458cb885": {
      "icon": "https://devicons.railway.app/i/redis.svg",
      "name": "Redis",
      "build": {},
      "deploy": {
        "startCommand": "/bin/sh -c \"exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --appendonly yes --appendfsync everysec --save '' --maxmemory-policy noeviction\"",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "redis:8.10.2-alpine"
      },
      "variables": {
        "REDIS_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated Redis password",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "30",
          "description": "Time for Redis to flush its append-only file on redeploy",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "a9d419dd-c4ed-47cc-9405-ad89458cb885": {
          "mountPath": "/data"
        }
      }
    }
  }
}